<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#FF10131A</Color>
    <Color x:Key="PanelBackgroundColor">#FF181D26</Color>
    <Color x:Key="PanelAltBackgroundColor">#FF1D2330</Color>
    <Color x:Key="TextPrimaryColor">#FFF2F5FA</Color>
    <Color x:Key="TextSecondaryColor">#FFA6B0C2</Color>
    <Color x:Key="BorderColor">#FF303847</Color>
    <Color x:Key="HoverColor">#FF242B37</Color>
    <Color x:Key="SelectionColor">#FF233A68</Color>
    <Color x:Key="AccentColor">#FF6794FF</Color>
    <Color x:Key="AccentHoverColor">#FF81A6FF</Color>
    <Color x:Key="SuccessColor">#FF4BC796</Color>
    <Color x:Key="WarningColor">#FFFFB653</Color>
    <Color x:Key="DangerColor">#FFFF7380</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{DynamicResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="PanelAltBackgroundBrush" Color="{DynamicResource PanelAltBackgroundColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{DynamicResource SelectionColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
</ResourceDictionary>
